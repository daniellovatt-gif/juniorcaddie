# Copy this file to .env and fill in the real service_role key.
# .env is git-ignored - never commit the real key.

# Staging branch project URL (not production - staging has its own project ref)
SUPABASE_URL=https://kyjgpordhmsjpltsavyf.supabase.co

# Staging service_role key - from Supabase dashboard > staging branch > Project Settings > API
# NEVER the anon/publishable key - this script relies on service_role to read entry_url,
# which is deliberately unreadable by the anon key (see CLAUDE.md §12).
SUPABASE_SERVICE_ROLE_KEY=
